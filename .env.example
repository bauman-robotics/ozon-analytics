# Скопируйте этот файл в .env и заполните своими значениями.
# Подробная инструкция: README → «API-ключ: как создать и куда положить».
#
# Client-Id и API-ключ: личный кабинет → Настройки → API ключи (Seller API).
# Ключ показывается один раз — сохраните его сразу.

OZON_CLIENT_ID=
OZON_API_KEY=

# Необязательные настройки
# OZON_RPS=10
# OZON_TIMEOUT=30
# OZON_BASE_URL=https://api-seller.ozon.ru
